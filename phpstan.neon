includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - app
        - bootstrap
        - config
        - database
        - lang
        - routes
    checkMissingCallableSignature: true
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # El modelo User todavía no existe; la configuración de autenticación ya lo nombra.
        -
            identifier: class.notFound
            path: config/auth.php
            count: 1
