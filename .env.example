APP_NAME=TikaroChat
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tikarochat.example

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tikarochat
DB_USERNAME=tikaro_app
DB_PASSWORD=CHANGE_ME
# Usuario con DDL, solo para correr migraciones (php artisan migrate --database=mysql_migrator).
DB_MIGRATOR_USERNAME=tikaro_migrator
DB_MIGRATOR_PASSWORD=CHANGE_ME
# Solo para el contenedor local de MySQL; en producción no existe.
DB_ROOT_PASSWORD=CHANGE_ME
# Certificado de la autoridad que firma el servidor MySQL; obligatorio en producción.
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=tikarochat

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS=soporte@tikarochat.example
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
