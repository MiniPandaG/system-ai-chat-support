{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "tikarochat/tikarochat",
    "type": "project",
    "description": "Plataforma SaaS multi-empresa de soporte al cliente con tickets, chat e IA.",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "inertiajs/inertia-laravel": "^3.6",
        "laravel/fortify": "^1.41",
        "laravel/framework": "^13.17",
        "laravel/reverb": "^1.12",
        "webklex/php-imap": "^6.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "pest"
        ],
        "format": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G --no-progress",
        "security": "@composer audit",
        "qa": [
            "@format",
            "@analyse",
            "@test",
            "@security"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "abandoned": "fail"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
