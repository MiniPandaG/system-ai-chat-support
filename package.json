{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "tikarochat",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@9.15.9",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build && vite build --config vite.widget.config.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint resources/js vite.config.ts vite.widget.config.ts vitest.config.ts",
        "test": "vitest run",
        "qa": "pnpm typecheck && pnpm lint && pnpm test && pnpm audit"
    },
    "dependencies": {
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@fontsource/space-grotesk": "^5.3.0",
        "@fontsource/work-sans": "^5.3.0",
        "@inertiajs/react": "^3.10.0",
        "pusher-js": "8.6.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "pnpm": {
        "overrides": {
            "minimatch": "^11.0.1"
        }
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "^5.28.8",
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^24.0.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.14.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "jsdom": "^30.1.3",
        "laravel-vite-plugin": "^3.2.0",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    }
}
